#!/usr/bin/env python3
"""agentbox — isolated agent workspace manager"""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import math
import os
import re
import shutil
import socket
import subprocess
import sys
import time
from contextlib import ExitStack, contextmanager
from datetime import datetime, timezone
from pathlib import Path
from typing import Iterator, NamedTuple, NoReturn

import yaml

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "proxy" / "addons"))
from secret_contract import fingerprint, injection_secret_name, synchronization_frame

AGENTBOX_HOME   = Path(os.environ.get("AGENTBOX_HOME", Path.home() / ".local" / "share" / "agentbox"))
AGENTBOX_PRESET = os.environ.get("AGENTBOX_PRESET", "default")
# Match Compose's ${AGENTBOX_IMAGE_TAG:-latest}: empty also means latest.
AGENTBOX_IMAGE_TAG = os.environ.get("AGENTBOX_IMAGE_TAG") or "latest"

_state_home = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state"))
AGENTBOX_STATE = Path(os.environ.get("AGENTBOX_STATE", _state_home / "agentbox"))

HARNESS_CONTAINERFILES = {
    p.name.split(".", 1)[1]: p.name
    for p in sorted((AGENTBOX_HOME / "agent").glob("Containerfile.*"))
}
HARNESS_CONTAINERFILES.update({"proxy": "Containerfile"})


# ── Helpers ───────────────────────────────────────────────────────────────────

def die(msg: str) -> NoReturn:
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)


def _base_project_name(path: Path) -> str:
    name = re.sub(r"[^a-z0-9]+", "-", path.resolve().name.lower()).strip("-")
    return name or "agentbox"


def free_port() -> int:
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def _session_id(name: str, project_dir: Path) -> str:
    """Deterministic session directory name: <name>-<sha256(project_dir)>."""
    h = hashlib.sha256(str(project_dir.resolve()).encode()).hexdigest()
    return f"{name}-{h}"


def _project_name(session_dir: Path, meta: dict | None = None) -> str:
    """Give each session its own Compose project, even if directories share a basename."""
    if meta is None:
        meta = read_compose_metadata(session_dir)
    name = f"agentbox-{_base_project_name(Path(meta['project-dir']))}-{meta['name']}"
    return f"{name}-{hashlib.sha256(session_dir.name.encode()).hexdigest()[:12]}"


def _persistent_name(session_dir: Path, service: str) -> str:
    digest = hashlib.sha256(session_dir.name.encode()).hexdigest()[:20]
    return f"agentbox-{digest}-{service}"


def _persistent(session_dir: Path) -> bool:
    value = read_compose_metadata(session_dir).get("persist", False)
    if not isinstance(value, bool):
        die("x-metadata.persist must be true or false")
    return value


def find_project_dir() -> Path:
    """Find the project root by walking up from cwd to the git root, or cwd itself."""
    result = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    if result.returncode == 0 and result.stdout.strip():
        return Path(result.stdout.strip())
    return Path.cwd()


def _session_dirs() -> list[Path]:
    """Enumerate the active installation's session registry without probing Podman."""
    sessions_dir = AGENTBOX_STATE / "sessions"
    try:
        return sorted(d for d in sessions_dir.iterdir() if d.is_dir())
    except FileNotFoundError:
        return []


def _session_info(session_dir: Path) -> dict:
    meta = read_compose_metadata(session_dir)
    if (not isinstance(meta, dict) or not isinstance(meta.get("name"), str) or not meta["name"]
            or not isinstance(meta.get("project-dir"), str) or not Path(meta["project-dir"]).is_absolute()
            or not isinstance(meta.get("persist", False), bool)):
        raise ValueError("Invalid session metadata")
    return {"name": meta["name"], "project": meta["project-dir"], "session_id": session_dir.name,
            "persistent": meta.get("persist", False)}


def get_sessions(project_dir: Path) -> list[str]:
    """Return sorted session names for a given project directory."""
    resolved = str(project_dir.resolve())
    names = []
    for d in _session_dirs():
        info = _session_info(d)
        if info["project"] == resolved:
            names.append(info["name"])
    return sorted(names)


def require_session(project_dir: Path, name: str | None) -> Path:
    """Return session_dir, auto-detecting if exactly one session exists."""
    if name:
        session_id = _session_id(name, project_dir)
        d = AGENTBOX_STATE / "sessions" / session_id
        if not d.is_dir():
            die(f"session '{name}' not found — run: agentbox list")
        return d
    sessions = get_sessions(project_dir)
    if len(sessions) == 1:
        return AGENTBOX_STATE / "sessions" / _session_id(sessions[0], project_dir)
    if not sessions:
        die("No sessions. Run: agentbox init --name <name>")
    die(f"Multiple sessions ({', '.join(sessions)}) — specify: --name <name>")


def resolve_session(args) -> tuple[Path, Path]:
    """Resolve session_dir and project_dir from --session or --name flag."""
    session_id = getattr(args, "session", None)
    name = getattr(args, "name", None)
    if session_id is not None and name is not None:
        die("--session and --name are mutually exclusive")
    if session_id == "" or name == "":
        die("Session selectors must not be empty")
    if session_id:
        if session_id in (".", "..") or Path(session_id).name != session_id:
            die("--session requires a full session ID, not a path")
        d = AGENTBOX_STATE / "sessions" / session_id
        if not d.is_dir():
            die(f"session '{session_id}' not found — run: agentbox list --all")
    else:
        d = require_session(find_project_dir(), name)
    try:
        info = _session_info(d)
    except (OSError, ValueError, AttributeError, yaml.YAMLError):
        die(f"session '{d.name}' has no valid compose.yaml metadata")
    return d, Path(info["project"])


def compose(session_dir: Path, *args: str, **kwargs) -> subprocess.CompletedProcess:
    env = {
        **os.environ,
        "AGENTBOX_HOME": str(AGENTBOX_HOME),
    }
    cmd = [
        "podman", "compose",
        "--project-name", _project_name(session_dir),
        "-f", str((session_dir / "compose.yaml").resolve()),
        *args,
    ]
    return subprocess.run(cmd, env=env, **kwargs)


@contextmanager
def _secret_sync_lock(session_dir: Path, *, if_exists: bool = False) -> Iterator[bool]:
    try:
        lock = (session_dir / ".secret-sync.lock").open("a")
    except FileNotFoundError:
        if if_exists:
            yield False
            return
        die("session removed while waiting for secret synchronization")
    with lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        # A remove command may have deleted the session while we waited.
        if not (session_dir / "compose.yaml").is_file():
            if if_exists:
                yield False
                return
            die("session removed while waiting for secret synchronization")
        yield True


@contextmanager
def _proxy_lifetime(session_dir: Path) -> Iterator[None]:
    """Enter under the sync lock after synchronization, before launching an agent."""
    lock_path = session_dir / ".lifetime.lock"
    with lock_path.open("a") as f:
        fd = f.fileno()
        fcntl.flock(fd, fcntl.LOCK_SH)
        try:
            yield
        finally:
            if session_dir.exists():
                with _secret_sync_lock(session_dir):
                    fcntl.flock(fd, fcntl.LOCK_UN)
                    try:
                        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    except BlockingIOError:
                        pass
                    else:
                        compose(session_dir, "down", check=True)


@contextmanager
def _persistent_lifetime(session_dir: Path) -> Iterator[None]:
    with (session_dir / ".lifetime.lock").open("a") as lock:
        try:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            die("session already running; stop it and wait for the active start to finish")
        yield


def read_compose_metadata(session_dir: Path) -> dict:
    """Read x-metadata from the session's compose.yaml."""
    compose_cfg = load_yaml(session_dir / "compose.yaml") if (session_dir / "compose.yaml").is_file() else {}
    return compose_cfg.get("x-metadata", {})


def read_port(session_dir: Path) -> int | None:
    compose_cfg = load_yaml(session_dir / "compose.yaml") if (session_dir / "compose.yaml").is_file() else {}
    ports = compose_cfg.get("services", {}).get("proxy", {}).get("ports", [])
    if ports:
        # "127.0.0.1:<port>:8081"
        return int(str(ports[0]).split(":")[1])
    return None


def load_yaml(path: Path) -> dict:
    with path.open() as f:
        return yaml.safe_load(f) or {}


def save_yaml(path: Path, cfg: dict) -> None:
    with path.open("w") as f:
        yaml.dump(cfg, f, default_flow_style=False, allow_unicode=True)


def _resolve_images(images: dict[str, str]) -> dict[str, str]:
    """Use native Compose interpolation without expanding session environments."""
    config = {"services": {name: {"image": image} for name, image in images.items()}}
    result = subprocess.run(
        ["podman", "compose", "--env-file", os.devnull,
         "--project-name", "agentbox-images", "-f", "-", "config"],
        input=yaml.safe_dump(config), stdout=subprocess.PIPE, text=True, check=True,
    )
    resolved = yaml.safe_load(result.stdout)["services"]
    return {name: resolved[name]["image"] for name in images}


def _container_running(container: dict | None) -> bool:
    return bool(container and container["state"] == "running")


def _stop_persistent(session_dir: Path) -> None:
    result = compose(session_dir, "stop")
    containers = _list_session_containers(session_dir)
    if result.returncode or any(_container_running(c) for c in containers):
        die("could not stop both session containers; run agentbox stop and inspect the session")


class SecretReference(NamedTuple):
    source: str
    host_path: Path
    target: str
    provider: str


def discover_secrets(cfg: dict, project_dir: Path) -> list[SecretReference]:
    """Discover once for preflight/validation; Compose never declares secrets."""
    if not project_dir.is_absolute():
        raise ValueError("Session project-dir must be absolute")
    references = []
    sources = set()
    targets = {}
    for provider in cfg.get("providers", []):
        if not provider.get("enabled"):
            continue
        policies = provider.get("injection_policy")
        policies = [provider] if policies is None else list(policies)
        for rule in provider.get("request_policy", []):
            policies.extend(rule.get("injection_policy", []))
        for policy in policies:
            source = policy.get("api_key_file", "")
            if not source:
                continue
            target = injection_secret_name(source)
            if source in sources:
                continue
            if target in targets and targets[target] != source:
                raise ValueError("Provider secret target collision")
            sources.add(source)
            targets[target] = source
            path = Path(source).expanduser()
            if not path.is_absolute():
                path = project_dir / path
            try:
                path = path.resolve()
            except (OSError, RuntimeError, ValueError):
                # Inaccessible parents and symlink loops are unavailable sources,
                # not configuration errors. The open below reports them per source.
                pass
            references.append(SecretReference(source, path, target,
                                              provider.get("name", "?")))
    return references


def _read_source(reference: SecretReference) -> bytes | None:
    try:
        payload = reference.host_path.read_bytes()
        if not payload.decode("utf-8").strip():
            raise ValueError
        return payload
    except (OSError, ValueError):
        print(f"Warning: provider {reference.provider}: source {reference.source} "
              "is not transferable; checking proxy fallback on reload", file=sys.stderr)
        return None


def _secret_preflight(session_dir: Path) -> tuple[str, str, list]:
    try:
        with (session_dir / "proxy-config" / "proxy.yaml").open() as stream:
            cfg = yaml.safe_load(stream)
        if not isinstance(cfg, dict):
            raise ValueError
        full = fingerprint(cfg)
        providers = fingerprint(cfg.get("providers", []))
        references = discover_secrets(cfg, Path(read_compose_metadata(session_dir)["project-dir"]))
    except (OSError, ValueError, TypeError, AttributeError, yaml.YAMLError):
        die("Invalid session provider configuration or secret target; fix proxy.yaml and rerun")
    return full, providers, [(ref, _read_source(ref)) for ref in references]


def _reload_proxy(session_dir: Path) -> dict:
    """Fast allow/deny reload; provider changes require synchronization."""
    result = compose(session_dir, "exec", "-T", "proxy", "curl", "-sS", "--max-time", "120",
                     "-w", "\n%{http_code}", "http://127.0.0.1:8082/reload",
                     capture_output=True, text=True)
    if result.returncode:
        die("Proxy reload failed; rerun the command when the proxy is ready")
    body, _, status = result.stdout.rpartition("\n")
    if status == "409":
        try:
            restart_required = json.loads(body).get("restart_required") is True
        except (ValueError, AttributeError):
            restart_required = False
        if restart_required:
            die("Allowlist edit saved but not active: HTTP protocol policy changed. "
                "Run agentbox proxy-restart to apply it")
        die("Allowlist edit saved but not active: provider changes are pending. "
            "Run agentbox proxy-reload to apply both changes")
    if status != "200":
        die("Proxy rejected the configuration; fix proxy.yaml and rerun")
    try:
        response = json.loads(body)
        if not isinstance(response, dict):
            raise ValueError
        return response
    except ValueError:
        die("Invalid proxy reload response; rerun the command")


def _synchronize_proxy(session_dir: Path, full: str, providers: str,
                       sources: list[tuple[SecretReference, bytes | None]]) -> None:
    """One exec performs readiness, reset, transfer, and provider reload under the sync lock."""
    frame = synchronization_frame(full, [(ref.target, payload) for ref, payload in sources
                                          if payload is not None])
    result = compose(session_dir, "exec", "-T", "proxy", "python3", "/app/manage_secrets.py",
                     "sync", input=frame, capture_output=True)
    del frame
    if result.returncode:
        die("Proxy synchronization failed; verify the proxy is running and rerun the command")
    try:
        reply = json.loads(result.stdout)
        status, applied = reply["status"], reply["body"]
        if not isinstance(status, int) or not isinstance(applied, dict):
            raise ValueError
    except (ValueError, TypeError, KeyError):
        die("Invalid proxy synchronization response; rerun the command")
    if status == 409:
        if applied.get("restart_required") is True:
            die("HTTP protocol policy changed; run agentbox proxy-restart to apply it")
        die("Concurrent configuration change; rerun the synchronization command")
    if status != 200:
        die("Proxy rejected the configuration; fix proxy.yaml and rerun")
    if applied.get("fingerprint") != full or applied.get("provider_fingerprint") != providers:
        die("Applied configuration fingerprint mismatch; rerun the synchronization command")
    for policy in applied.get("unavailable", []):
        print(f"Warning: provider {policy['provider']}, policy {policy['policy']}: credential unavailable",
              file=sys.stderr)


def resolve_preset(name: str) -> Path:
    custom = AGENTBOX_HOME / "custom" / "presets" / name
    if custom.is_dir():
        return custom
    return AGENTBOX_HOME / "presets" / name


def resolve_preset_file(preset_dir: Path, filename: str) -> Path | None:
    path = preset_dir / filename
    if path.is_file():
        return path
    default = AGENTBOX_HOME / "presets" / "default" / filename
    if default.is_file():
        return default
    return None


def generate_compose(
    session_dir: Path,
    project_dir: Path,
    name: str,
    port: int,
    proxy_cfg: dict,
    agent_cfg: dict,
    context_mounts: list[tuple[str, str, bool]],
    persist: bool = False,
) -> None:
    """Build a unified compose.yaml from compose-base.yaml and preset config."""
    base = load_yaml(AGENTBOX_HOME / "compose-base.yaml")

    # Resolve only image references, after the preset has selected the agent image.
    agent = base["services"]["agent"]
    agent["image"] = agent_cfg.get("agent_image", agent["image"])
    images = _resolve_images({name: base["services"][name]["image"] for name in ("proxy", "agent")})
    for service, image in images.items():
        base["services"][service]["image"] = image

    # --- Session metadata (Compose extension field) ---
    base["x-metadata"] = {
        "project-dir": str(project_dir.resolve()),
        "name": name,
        "persist": persist,
    }

    if persist:
        for service in ("agent", "proxy"):
            base["services"][service]["container_name"] = _persistent_name(session_dir, service)

    # --- Proxy service ---
    proxy = base["services"]["proxy"]
    proxy["ports"] = [f"127.0.0.1:{port}:8081"]

    proxy_volumes: list = proxy.get("volumes", [])
    proxy_volumes.append("./proxy-config:/config:ro,Z")

    for vol in proxy_cfg.get("proxy_volumes", []):
        src = Path(vol["src"]).expanduser().resolve()
        dst = vol["dst"]
        if src.exists():
            # Host OAuth sources can be mounted by multiple proxy sessions.
            # A private :Z relabel would revoke access from earlier containers.
            proxy_volumes.append(f"{src}:{dst}:ro,z")
        else:
            print(f"Warning: proxy_volumes source not found: {src}")

    for cert_name in proxy_cfg.get("trusted_certificates", []):
        cert_path = AGENTBOX_HOME / "custom" / "certs" / cert_name
        if cert_path.is_file():
            proxy_volumes.append(f"{cert_path}:/custom-certs/{cert_name}:ro,Z")
        else:
            print(f"Warning: trusted certificate not found: {cert_path}")

    proxy["volumes"] = proxy_volumes

    proxy_env: dict = proxy.get("environment", {})
    proxy_env.update(proxy_cfg.get("environment") or {})
    proxy_env["AGENTBOX_NAME"] = name
    proxy["environment"] = proxy_env

    # --- Agent service ---
    agent = base["services"]["agent"]

    agent_volumes: list = agent.get("volumes", [])
    if (session_dir / "dotfiles").is_dir():
        agent_volumes.append("./dotfiles:/agentbox-dotfiles:ro,Z")
    has_bundle = (session_dir / "source.bundle").is_file()
    output_dir = session_dir / "output.git"
    if has_bundle:
        agent_volumes.append("./source.bundle:/source/project.bundle:ro,Z")
    if output_dir.is_dir():
        agent_volumes.append("./output.git:/output/repo.git:Z")
        # Read-only bind mount over hooks and git config — kernel-enforced, not just chmod.
        # Without this the agent can chmod 755 the dir and write executable
        # hooks or custom scripts in git config.
        agent_volumes.append("./output.git/hooks:/output/repo.git/hooks:ro")
        agent_volumes.append("./output.git/config:/output/repo.git/config:ro")
    if not has_bundle and not output_dir.is_dir():
        agent_volumes.append(f"{project_dir}:/workspace:Z")
    for src, dst, writable in context_mounts:
        opts = "Z" if writable else "ro,Z"
        agent_volumes.append(f"{src}:/context/{dst}:{opts}")
    agent["volumes"] = agent_volumes

    agent_preset_env = agent_cfg.get("environment") or {}
    agent_env: dict = agent.get("environment", {})
    agent_env.update(agent_preset_env)
    agent_env["AGENTBOX_NAME"] = name
    agent["environment"] = agent_env

    agent_annotations = agent_cfg.get("annotations") or {}
    if agent_annotations:
        agent["annotations"] = agent_annotations

    save_yaml(session_dir / "compose.yaml", base)


# ── Commands ──────────────────────────────────────────────────────────────────

def _resolve_gh_token() -> str | None:
    token = os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN")
    if token:
        return token
    try:
        result = subprocess.run(["gh", "auth", "token"], capture_output=True, text=True, timeout=5)
        if result.returncode == 0 and result.stdout.strip():
            return result.stdout.strip()
    except (FileNotFoundError, subprocess.TimeoutExpired):
        pass
    return None


def _build_images(no_cache: bool = False, harnesses: list[str] | None = None, tag: str | None = None) -> None:
    tag = tag or AGENTBOX_IMAGE_TAG
    extra = ["--no-cache"] if no_cache else []

    targets = harnesses if harnesses else list(HARNESS_CONTAINERFILES.keys())
    build_env = dict(os.environ)

    for name in targets:
        agent_ctx = AGENTBOX_HOME / ("proxy" if name == "proxy" else "agent")
        image_tag = f"localhost/agentbox-agent-{name}:{tag}"

        if name == "proxy":
            image_tag = f"localhost/agentbox-proxy:{tag}"

        containerfile = HARNESS_CONTAINERFILES[name]
        cf_path = agent_ctx / containerfile
        if not cf_path.is_file():
            print(f"Warning: {cf_path} not found, skipping {name} image build")
            continue
        if name == "claude" and not (agent_ctx / "keys" / "claude-code.asc").is_file():
            die(f"Claude Code GPG key not found at {agent_ctx / 'keys' / 'claude-code.asc'}\n"
                f"       Download it and verify its fingerprint:\n"
                f"         curl -fsSLo {agent_ctx / 'keys' / 'claude-code.asc'} https://downloads.claude.ai/keys/claude-code.asc\n"
                f"         gpg --show-keys --fingerprint {agent_ctx / 'keys' / 'claude-code.asc'}")

        build_args = [] if name in ("base", "proxy") else ["--build-arg", f"AGENTBOX_IMAGE_TAG={tag}"]
        secret_args: list[str] = []
        if name == "opencode":
            skip_opencode_verify = os.environ.get("AGENTBOX_BUILD_OPENCODE_SKIP_VERIFICATION", "")
            gh_token = None if skip_opencode_verify else _resolve_gh_token()
            if skip_opencode_verify:
                build_args += ["--build-arg", "AGENTBOX_BUILD_OPENCODE_SKIP_VERIFICATION=1"]
            elif gh_token:
                secret_args = ["--secret", f"id=gh_token,env=_AGENTBOX_GH_TOKEN"]
            else:
                die("Error: no GH_TOKEN found, opencode build will fail without attestation verification\n"
                    "       Set AGENTBOX_BUILD_OPENCODE_SKIP_VERIFICATION=1 to skip verification")
            if gh_token:
                build_env["_AGENTBOX_GH_TOKEN"] = gh_token

        print(f"==> Building {name} agent image...")
        subprocess.run(
            ["podman", "build", *extra, *build_args, *secret_args, "-f", str(cf_path), "-t", image_tag, str(agent_ctx)],
            check=True,
            env=build_env,
        )


def _validate_harnesses(names: list[str]) -> None:
    for name in names:
        if name not in HARNESS_CONTAINERFILES:
            die(f"unknown harness '{name}'. Choices: {', '.join(HARNESS_CONTAINERFILES)}")


def cmd_build(args) -> None:
    if args.harnesses:
        _validate_harnesses(args.harnesses)
    print("==> Building images...")
    _build_images(harnesses=args.harnesses or None, tag=args.tag or AGENTBOX_IMAGE_TAG)
    print("==> Done. Run 'agentbox update' after pulling a new version.")


def cmd_update(args) -> None:
    if args.harnesses:
        _validate_harnesses(args.harnesses)
    print("==> Rebuilding images without cache...")
    _build_images(no_cache=True, harnesses=args.harnesses or None, tag=args.tag or AGENTBOX_IMAGE_TAG)
    print("==> Done.")


def _fetch_output(session_dir: Path) -> None:
    output_git = session_dir / "output.git"
    if not output_git.is_dir():
        return
    meta = read_compose_metadata(session_dir)
    name = meta["name"]
    project_dir = Path(meta["project-dir"])
    print(f"\n==> Fetching agent output (agentbox-{name})...")
    r = subprocess.run(["git", "-C", str(project_dir), "-c", "core.hooksPath=/dev/null", "fetch", f"agentbox-{name}"])
    if r.returncode == 0:
        ls = subprocess.run(["git", "-C", str(project_dir), "branch", "-r", "--list", f"agentbox-{name}/*"], capture_output=True, text=True)
        branches = [b.strip() for b in ls.stdout.splitlines() if b.strip()]
        for b in branches:
            print(f"  {b}")
        if branches:
            print(f"  To apply: git merge {branches[0]}")


def _launch_persistent(session_dir: Path, cmd: list[str] | None) -> int:
    name = _persistent_name(session_dir, "agent")
    with ExitStack() as lifetime:
        with _secret_sync_lock(session_dir):
            lifetime.enter_context(_persistent_lifetime(session_dir))
            containers = {c["name"]: c for c in _list_session_containers(session_dir)}
            agent = containers.get(name)
            if _container_running(agent):
                die("session already running; use agentbox stop to recover an unattached agent")
            if agent and cmd:
                die("a persistent agent already exists; start without -- CMD to reuse its saved command")

            full, providers, sources = _secret_preflight(session_dir)
            proxy_started_here = not _container_running(containers.get(_persistent_name(session_dir, "proxy")))
            try:
                # podman-compose's up otherwise tears down *all* services when
                # the Compose YAML changes, including a retained agent.
                compose(session_dir, "up", "-d", "--no-recreate", "proxy", check=True)
                _synchronize_proxy(session_dir, full, providers, sources)
                del sources
                if agent is None:
                    if cmd:
                        cfg = load_yaml(session_dir / "compose.yaml")
                        cfg["services"]["agent"]["command"] = cmd
                        save_yaml(session_dir / "compose.yaml", cfg)
                    # podman-compose has no `create` subcommand. This creates
                    # only the agent service, without restarting the proxy or
                    # recreating an existing container after a YAML change.
                    compose(session_dir, "up", "--no-start", "--no-deps", "--no-recreate", "agent", check=True)
                    if not any(c["name"] == name for c in _list_session_containers(session_dir)):
                        die("Compose did not create the persistent agent service container")
            except BaseException:
                if proxy_started_here:
                    _stop_persistent(session_dir)
                raise

        exit_code = None
        try:
            # start -ai blocks until exit. Stop may race here and stop the proxy
            # after synchronization but before the agent starts.
            attached = subprocess.run(["podman", "start", "-ai", name]).returncode
        finally:
            with _secret_sync_lock(session_dir, if_exists=True) as exists:
                if exists:
                    try:
                        agent = next((c for c in _list_session_containers(session_dir) if c["name"] == name), None)
                        if agent and agent["state"] == "exited":
                            result = subprocess.run(["podman", "inspect", "--format", "{{.State.ExitCode}}", agent["id"]],
                                                    capture_output=True, text=True, check=True)
                            exit_code = int(result.stdout.strip())
                        _stop_persistent(session_dir)
                    finally:
                        _fetch_output(session_dir)
        return exit_code if isinstance(exit_code, int) else attached


def _launch(session_dir: Path, cmd: list[str] | None = None) -> None:
    if _persistent(session_dir):
        sys.exit(_launch_persistent(session_dir, cmd))
    with ExitStack() as lifetime:
        with _secret_sync_lock(session_dir):
            full, providers, sources = _secret_preflight(session_dir)
            compose(session_dir, "up", "-d", "proxy", check=True)
            _synchronize_proxy(session_dir, full, providers, sources)
            del sources
            lifetime.enter_context(_proxy_lifetime(session_dir))
        # Dependency startup would be another proxy lifecycle action outside the lock.
        result = compose(session_dir, "run", "--rm", "--no-deps", "agent", *(cmd or []))
    _fetch_output(session_dir)
    sys.exit(result.returncode)


def cmd_init(args) -> None:
    project_dir = Path(args.dir).resolve() if args.dir else Path.cwd()
    name = args.name or time.strftime("%Y%m%d-%H%M%S")
    if not re.match(r"^[a-z0-9][a-z0-9._-]*$", name):
        die(f"invalid session name '{name}' — use lowercase letters, digits, hyphens, dots")
    session_id = _session_id(name, project_dir)
    session_dir = AGENTBOX_STATE / "sessions" / session_id

    if (session_dir / "compose.yaml").is_file():
        with _secret_sync_lock(session_dir):
            if _persistent(session_dir) != args.persist:
                die("cannot change a session's persistence mode; create a new named session")
            if args.persist and any(c["name"] == _persistent_name(session_dir, "agent")
                                    for c in _list_session_containers(session_dir)):
                die("persistent agent already exists; use start or create a new session")
            _init_session(session_dir, project_dir, name, args)
    else:
        _init_session(session_dir, project_dir, name, args)

    if args.start:
        _launch(session_dir)
    else:
        print(f"==> Initialized. Run 'agentbox start --name {name}' to start")
        print(f"==> or start a tmux session:")
        print(f"agentbox start --name {name} -- tmux -u new-session -s agent 'bash -l' ';' send-keys -t agent 'agent' Enter")


def _init_session(session_dir: Path, project_dir: Path, name: str, args) -> None:
    print(f"==> Initializing agentbox '{name}': {project_dir}")
    session_dir.mkdir(parents=True, exist_ok=True)

    proxy_config_dir = session_dir / "proxy-config"
    proxy_config_dir.mkdir(parents=True, exist_ok=True)
    proxy_file = proxy_config_dir / "proxy.yaml"
    preset_dir = resolve_preset(args.preset)
    if not preset_dir.is_dir():
        die(f"preset '{args.preset}' not found")
    proxy_src = resolve_preset_file(preset_dir, "proxy.yaml")
    if not proxy_src:
        die(f"preset '{args.preset}' has no proxy.yaml (and no default fallback)")
    if not proxy_file.is_file():
        proxy_cfg = load_yaml(proxy_src)
        proxy_cfg.pop("environment", None)
        save_yaml(proxy_file, proxy_cfg)

    proxy_cfg = load_yaml(proxy_src)
    agent_src = resolve_preset_file(preset_dir, "agent.yaml")
    agent_cfg = load_yaml(agent_src) if agent_src else {}

    # Write dotfiles from agent config into session dotfiles directory
    dotfiles = agent_cfg.get("dotfiles", {})
    if dotfiles:
        dotfiles_dir = session_dir / "dotfiles"
        for rel_path, content in dotfiles.items():
            clean = rel_path.lstrip("~").lstrip("/")
            dest = dotfiles_dir / clean
            dest.parent.mkdir(parents=True, exist_ok=True)
            dest.write_text(content or "")

    use_git = not args.no_git
    if use_git:
        in_repo = subprocess.run(["git", "-C", str(project_dir), "rev-parse", "--git-dir"], capture_output=True).returncode == 0

        if in_repo:
            branch = args.branch
            if not branch:
                branch = subprocess.run(["git", "-C", str(project_dir), "branch", "--show-current"], capture_output=True, text=True).stdout.strip()
            if not branch:  # detached HEAD
                branch = subprocess.run(["git", "-C", str(project_dir), "rev-parse", "--short", "HEAD"], capture_output=True, text=True, check=True).stdout.strip()
                print(f"    Detached HEAD — snapshotting commit {branch}")

            print(f"==> Creating source bundle (branch: {branch})...")
            subprocess.run(
                ["git", "-C", str(project_dir), "bundle", "create",
                 str(session_dir / "source.bundle"), "HEAD", branch],
                check=True,
            )

            output_git = session_dir / "output.git"
            subprocess.run(["git", "init", "--bare", str(output_git), "--quiet"], check=True)
            (output_git / "hooks").mkdir(exist_ok=True)
            (output_git / "config").touch(exist_ok=True)

            remote = f"agentbox-{name}"
            has_remote = subprocess.run(
                ["git", "-C", str(project_dir), "remote", "get-url", remote],
                capture_output=True,
            ).returncode == 0
            if has_remote:
                subprocess.run(["git", "-C", str(project_dir), "remote", "set-url", remote, str(output_git.resolve())], check=True)
            else:
                subprocess.run(["git", "-C", str(project_dir), "remote", "add", remote, str(output_git.resolve())], check=True)
            print(f"==> Git remote '{remote}' registered — 'git fetch {remote}' to review output mid-session.")
        else:
            print("==> No git repo found; falling back to --no-git mode.")
            use_git = False

    # Preserve existing context mounts from compose.yaml, then add any new ones from args
    context_mounts: list[tuple[str, str, bool]] = _read_context_mounts(session_dir)
    seen_dsts: set[str] = {d for _, d, _ in context_mounts}
    for spec in args.ro_mounts:
        src_str, _, dst = spec.partition(":")
        src = str(Path(src_str).resolve())
        dst = dst or Path(src_str).name
        if not Path(src).exists():
            die(f"mount source does not exist: {src}")
        if dst not in seen_dsts:
            context_mounts.append((src, dst, False))
            seen_dsts.add(dst)
    for spec in args.rw_mounts:
        src_str, _, dst = spec.partition(":")
        src = str(Path(src_str).resolve())
        dst = dst or Path(src_str).name
        if not Path(src).exists():
            die(f"mount source does not exist: {src}")
        if dst not in seen_dsts:
            context_mounts.append((src, dst, True))
            seen_dsts.add(dst)

    # Read existing port from compose.yaml if re-initializing, otherwise pick a free port
    web_port = read_port(session_dir) or free_port()

    generate_compose(
        session_dir=session_dir,
        project_dir=project_dir,
        name=name,
        port=web_port,
        proxy_cfg=proxy_cfg,
        agent_cfg=agent_cfg,
        context_mounts=context_mounts,
        persist=args.persist,
    )


def cmd_start(args) -> None:
    session_dir, _ = resolve_session(args)
    cmd = [a for a in (args.exec_cmd or [])] or None
    _launch(session_dir, cmd)


def cmd_stop(args) -> None:
    session_dir, _ = resolve_session(args)
    with _secret_sync_lock(session_dir):
        if _persistent(session_dir):
            _stop_persistent(session_dir)
        else:
            compose(session_dir, "down", check=True)


def cmd_logs(args) -> None:
    session_dir, _ = resolve_session(args)
    tail_args = ["--tail", str(args.tail)] if args.tail is not None else []
    result = compose(session_dir, "logs", "--follow", *tail_args, "proxy")
    sys.exit(result.returncode)


def cmd_web(args) -> None:
    session_dir, _ = resolve_session(args)
    web_port = read_port(session_dir)
    if not web_port:
        die("proxy port not found in session compose.yaml")
    print(f"http://localhost:{web_port}")


def _update_allowlist(host: str, add: bool, args) -> None:
    session_dir, _ = resolve_session(args)
    config_path = session_dir / "proxy-config" / "proxy.yaml"
    cfg = load_yaml(config_path)
    rules: list = cfg.setdefault("extra_request_policy", [])
    meta = read_compose_metadata(session_dir)
    session_name = meta["name"]

    port = None
    if ":" in host:
        parts = host.rsplit(":", 1)
        if parts[1].isdigit():
            host = parts[0]
            port = int(parts[1])

    escaped_host = re.escape(host)

    def _rule_matches(r: dict) -> bool:
        if r.get("host") != escaped_host:
            return False
        if port is not None:
            return r.get("port") == port
        return "port" not in r or r.get("port") == 443

    if add:
        if not any(_rule_matches(r) for r in rules):
            new_rule: dict = {"host": escaped_host}
            if port is not None:
                new_rule["port"] = port
            rules.append(new_rule)
            save_yaml(config_path, cfg)
            print(f"Added '{host}' to allowlist for session '{session_name}'.")
        else:
            print(f"'{host}' already in allowlist for session '{session_name}'.")
    else:
        new_rules = [r for r in rules if not _rule_matches(r)]
        if len(new_rules) < len(rules):
            cfg["extra_request_policy"] = new_rules
            save_yaml(config_path, cfg)
            print(f"Removed '{host}' from allowlist for session '{session_name}'.")
        else:
            print(f"'{host}' not in allowlist for session '{session_name}'.")
    _reload_proxy(session_dir)


def cmd_allow(args) -> None:
    _update_allowlist(args.host, add=True, args=args)


def cmd_deny(args) -> None:
    _update_allowlist(args.host, add=False, args=args)


def cmd_proxy_reload(args) -> None:
    session_dir, _ = resolve_session(args)
    with _secret_sync_lock(session_dir):
        full, providers, sources = _secret_preflight(session_dir)
        _synchronize_proxy(session_dir, full, providers, sources)
        del sources
    print("Proxy config reloaded.")


def cmd_proxy_restart(args) -> None:
    session_dir, _ = resolve_session(args)
    with _secret_sync_lock(session_dir):
        full, providers, sources = _secret_preflight(session_dir)
        compose(session_dir, "restart", "proxy", check=True)
        _synchronize_proxy(session_dir, full, providers, sources)
        del sources


def cmd_remove(args) -> None:
    session_dir, project_dir = resolve_session(args)
    meta = read_compose_metadata(session_dir)
    name = meta["name"]

    with _secret_sync_lock(session_dir):
        compose(session_dir, "down", "-v", check=True)
        remote = f"agentbox-{name}"
        subprocess.run(["git", "-C", str(project_dir), "remote", "remove", remote], capture_output=True)
        shutil.rmtree(session_dir, ignore_errors=True)

    print(f"Removed session '{name}'.")


def cmd_remote_cleanup(args) -> None:
    project_dir = find_project_dir()

    if subprocess.run(
        ["git", "-C", str(project_dir), "rev-parse", "--git-dir"],
        capture_output=True,
    ).returncode != 0:
        die("not a git repository")

    result = subprocess.run(
        ["git", "-C", str(project_dir), "remote"],
        capture_output=True, text=True, check=True,
    )
    agentbox_remotes = [r for r in result.stdout.splitlines() if r.startswith("agentbox-")]

    if not agentbox_remotes:
        print("No agentbox remotes found.")
        return

    sessions = get_sessions(project_dir)
    valid_remotes = {f"agentbox-{s}" for s in sessions}
    stale = [r for r in agentbox_remotes if r not in valid_remotes]

    if not stale:
        print("No stale agentbox remotes found.")
        return

    removed = 0
    for remote in stale:
        print(f"Removing stale remote '{remote}'...")
        if subprocess.run(["git", "-C", str(project_dir), "remote", "remove", remote], capture_output=True).returncode == 0:
            removed += 1
        else:
            print(f"  Warning: failed to remove remote '{remote}'")

    print(f"Cleaned up {removed} stale remote(s).")


def _read_context_mounts(session_dir: Path) -> list[tuple[str, str, bool]]:
    compose_cfg = load_yaml(session_dir / "compose.yaml") if (session_dir / "compose.yaml").is_file() else {}
    volumes = compose_cfg.get("services", {}).get("agent", {}).get("volumes", [])
    mounts = []
    for vol in volumes:
        if isinstance(vol, str) and ":/context/" in vol:
            parts = vol.split(":")
            src, dst_path = parts[0], parts[1]
            dst = dst_path[len("/context/"):]
            writable = len(parts) < 3 or not parts[2].startswith("ro")
            mounts.append((src, dst, writable))
    return mounts


def _list_sessions(show_all: bool) -> list[dict]:
    """Collect session info dicts for listing."""
    entries: list[dict] = []
    project = None if show_all else str(find_project_dir().resolve())
    for session_dir in _session_dirs():
        info = _session_info(session_dir)
        if project is not None and info["project"] != project:
            continue
        containers = _list_session_containers(session_dir)
        active = any(_container_running(c) and c["service"] == "agent" for c in containers)
        proxy_active = any(_container_running(c) and c["service"] == "proxy" for c in containers)
        port = read_port(session_dir)
        info.update(status="running" if active else "stopped",
                    url=f"http://localhost:{port}" if port and active and proxy_active else "")
        if not show_all:
            del info["project"]
        entries.append(info)
    return sorted(entries, key=lambda e: (e.get("project", ""), e["name"], e["session_id"]))


def _podman_json(*args: str) -> tuple[list[dict], bool]:
    """Read projected JSON records, retaining successful records on a partial failure."""
    try:
        result = subprocess.run(["podman", *args], capture_output=True, text=True)
    except (OSError, UnicodeError):
        return [], True
    records = []
    failed = result.returncode != 0
    for line in result.stdout.splitlines():
        if not line.strip():
            continue
        try:
            record = json.loads(line)
            if not isinstance(record, dict):
                raise ValueError
            records.append(record)
        except ValueError:
            failed = True
    return records, failed


def _discover_session_containers(session_dir: Path) -> tuple[list[dict], bool]:
    """Discover all service and one-off containers without per-container inspection."""
    project = _project_name(session_dir)
    records, failed = _podman_json(
        "ps", "-a", "--no-trunc", "--filter", f"label=com.docker.compose.project={project}", "--format",
        '{"id":{{json .ID}},"name":{{json .Names}},"state":{{json .State}},"pid":{{json .Pid}},'
        '"service":{{json (index .ListContainer.Labels "com.docker.compose.service")}},'
        '"project":{{json (index .ListContainer.Labels "com.docker.compose.project")}}}',
    )
    entries = {}
    for record in records:
        if (not all(isinstance(record.get(k), str) and record[k] for k in ("id", "name", "state", "project"))
                or type(record.get("pid")) is not int
                or record.get("service") is not None and not isinstance(record["service"], str)):
            failed = True
            continue
        if record.pop("project") == project:
            record["service"] = record.get("service") or None
            entries[record["id"]] = record
    return sorted(entries.values(), key=lambda c: (c["service"] or "", c["name"], c["id"])), failed


def _list_session_containers(session_dir: Path) -> list[dict]:
    entries, failed = _discover_session_containers(session_dir)
    if failed:
        raise RuntimeError("Could not discover session containers; verify Podman is available and accessible")
    return entries


_STATS_METRICS = ("cpu_percent", "memory_bytes", "disk_bytes")
_NONLIVE_STATES = {"created", "configured", "stopped", "exited"}


def _stats_error(errors: list[dict], code: str, message: str, session_id: str | None = None,
                 container_id: str | None = None, metric: str | None = None) -> None:
    errors.append({"code": code, "message": message, "session_id": session_id,
                   "container_id": container_id, "metric": metric})


def _stats_number(value, *, integer: bool = False):
    if type(value) not in ((int,) if integer else (int, float)) or value < 0:
        return None
    if isinstance(value, float) and not math.isfinite(value):
        return None
    return value


def _stats_records(ids: list[str]) -> dict[str, dict]:
    if not ids:
        return {}
    records, _ = _podman_json("stats", "--no-stream", "--no-trunc", "--format", "{{json .ContainerStats}}", *ids)
    return {r["ContainerID"]: r for r in records if r.get("ContainerID") in ids}


def _measure_containers(containers: dict[str, tuple[dict, dict]], errors: list[dict]) -> None:
    """Sample live counters together, then refresh state and size for the discovered IDs."""
    if not containers:
        return
    live = [cid for cid, (_, c) in containers.items() if c["state"] in ("running", "paused")]
    before = _stats_records(live)
    # Podman's first CPU report is a lifetime average. Two counter samples give
    # interval utilization without imposing a separate sampling delay per container.
    if before:
        time.sleep(1)
    after = _stats_records(live) if before else {}
    records, _ = _podman_json(
        "container", "inspect", "--size", "--format",
        '{"id":{{json .ID}},"state":{{json .State.Status}},"disk_bytes":{{json .SizeRw}}}', *containers,
    )
    sizes = {r["id"]: r for r in records if isinstance(r.get("id"), str)}
    missing = [cid for cid in containers if not isinstance(sizes.get(cid, {}).get("state"), str)
               or not sizes[cid]["state"]]
    # Size inspection can fail independently of state inspection (e.g. storage
    # driver permissions). Recover current states before classifying missing data.
    states = {}
    if missing:
        records, _ = _podman_json("container", "inspect", "--format",
                                 '{"id":{{json .ID}},"state":{{json .State.Status}}}', *missing)
        states = {r["id"]: r for r in records if isinstance(r.get("id"), str)}
    for cid, (session, container) in containers.items():
        sid = session["session_id"]
        container["disk_bytes"] = _stats_number(sizes.get(cid, {}).get("disk_bytes"), integer=True)
        details = states.get(cid, sizes.get(cid, {}))
        state = details.get("state")
        if isinstance(state, str) and state:
            container["state"] = state
        else:
            try:
                exists = subprocess.run(["podman", "container", "exists", cid], capture_output=True).returncode
            except OSError:
                exists = 125
            code = "container_disappeared" if exists == 1 else "metric_unavailable"
            _stats_error(errors, code, "Container state is unavailable; resource accounting may be incomplete", sid, cid)
            # Membership in CPU/RAM totals cannot be established, even if the
            # last discovery state was stopped. Retain that state for display.
            session["totals"].update(cpu_percent=None, memory_bytes=None)
            continue
        if container["disk_bytes"] is None:
            _stats_error(errors, "metric_unavailable", "Writable-layer size is unavailable", sid, cid, "disk_bytes")
        if container["state"] in _NONLIVE_STATES:
            continue
        first, last = before.get(cid, {}), after.get(cid, {})
        if container["state"] in ("running", "paused"):
            container["memory_bytes"] = _stats_number(last.get("MemUsage"), integer=True)
            counters = [first.get("CPUNano"), last.get("CPUNano"), first.get("SystemNano"), last.get("SystemNano")]
            if all(_stats_number(n, integer=True) is not None for n in counters):
                cpu_delta, time_delta = counters[1] - counters[0], counters[3] - counters[2]
                if cpu_delta >= 0 and time_delta > 0:
                    container["cpu_percent"] = _stats_number(cpu_delta / time_delta * 100)
        for metric in ("cpu_percent", "memory_bytes"):
            if container[metric] is None:
                _stats_error(errors, "metric_unavailable", "Live resource measurement is unavailable", sid, cid, metric)


def _collect_stats(session_dirs: list[Path] | None = None) -> dict:
    sessions, errors = [], []
    if session_dirs is None:
        try:
            session_dirs = _session_dirs()
        except OSError:
            _stats_error(errors, "session_metadata_unreadable", "Could not read the session registry")
            session_dirs = []
    projects = {}
    for session_dir in session_dirs:
        try:
            info = _session_info(session_dir)
            project = _project_name(session_dir, {"name": info["name"], "project-dir": info["project"]})
        except (OSError, ValueError, AttributeError, yaml.YAMLError):
            _stats_error(errors, "session_metadata_unreadable", "Session has no valid compose.yaml metadata", session_dir.name)
            continue
        info.update(containers=[], totals={k: 0.0 if k == "cpu_percent" else 0 for k in _STATS_METRICS})
        sessions.append(info)
        projects.setdefault(project, []).append((session_dir, info))

    containers = {}
    for group in projects.values():
        if len(group) != 1:
            for _, session in group:
                session["totals"] = dict.fromkeys(_STATS_METRICS)
                _stats_error(errors, "container_discovery_failed", "Sessions have conflicting Compose project identities",
                             session["session_id"])
            continue
        session_dir, session = group[0]
        try:
            entries, failed = _discover_session_containers(session_dir)
        except (OSError, ValueError, RuntimeError, AttributeError, KeyError, yaml.YAMLError):
            entries, failed = [], True
        if failed:
            session["totals"] = dict.fromkeys(_STATS_METRICS)
            _stats_error(errors, "container_discovery_failed", "Could not discover containers; verify Podman is available and accessible",
                         session["session_id"])
        for entry in entries:
            cid = entry["id"]
            if cid in containers:
                previous, _ = containers[cid]
                for owner in (previous, session):
                    owner["totals"] = dict.fromkeys(_STATS_METRICS)
                    _stats_error(errors, "container_discovery_failed", "Container belongs to conflicting sessions",
                                 owner["session_id"], cid)
                continue
            container = {k: entry[k] for k in ("id", "name", "service", "state")}
            container.update(dict.fromkeys(_STATS_METRICS))
            session["containers"].append(container)
            containers[cid] = session, container

    _measure_containers(containers, errors)
    for session in sessions:
        for metric in _STATS_METRICS:
            if session["totals"][metric] is None:
                continue
            members = [c for c in session["containers"] if metric == "disk_bytes" or c["state"] not in _NONLIVE_STATES]
            values = [c[metric] for c in members]
            session["totals"][metric] = (sum(values, 0.0 if metric == "cpu_percent" else 0)
                                        if all(v is not None for v in values) else None)
    return {"schema_version": 1, "collected_at": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
            "complete": not errors, "sessions": sorted(sessions, key=lambda s: (s["project"], s["name"], s["session_id"])),
            "errors": errors}


def _print_table(rows: list[list[str]], headers: list[str]) -> None:
    """Print a formatted table with column-aligned output."""
    rows = [[_table_text(cell) for cell in row] for row in rows]
    widths = [len(h) for h in headers]
    for row in rows:
        for i, cell in enumerate(row):
            widths[i] = max(widths[i], len(cell))
    fmt = "  ".join(f"{{:<{w}}}" for w in widths)
    print(fmt.format(*headers))
    for row in rows:
        print(fmt.format(*row))


def _table_text(value) -> str:
    return "".join(c if c.isprintable() else c.encode("unicode_escape").decode("ascii") for c in str(value))


def _format_bytes(value: int | None) -> str:
    if value is None:
        return "-"
    for unit in ("B", "KiB", "MiB", "GiB", "TiB", "PiB", "EiB"):
        if value < 1024 or unit == "EiB":
            return f"{value} B" if unit == "B" else f"{value:.2f} {unit}"
        value /= 1024


def _print_stats(snapshot: dict) -> None:
    if not snapshot["sessions"]:
        print("No sessions." if snapshot["complete"] else "No session statistics available.")
        return
    ids = [c["id"] for s in snapshot["sessions"] for c in s["containers"]]
    short = {cid: next((cid[:n] for n in range(12, len(cid) + 1)
                       if not any(other != cid and other.startswith(cid[:n]) for other in ids)), cid) for cid in ids}
    for i, session in enumerate(snapshot["sessions"]):
        if i:
            print()
        print(f"SESSION {_table_text(session['name'])}    PROJECT {_table_text(session['project'])}")
        print(f"SESSION ID {_table_text(session['session_id'])}")
        rows = []
        for container in session["containers"]:
            rows.append([short[container["id"]], container["name"], container["state"],
                         "-" if container["cpu_percent"] is None else f"{container['cpu_percent']:.2f}",
                         _format_bytes(container["memory_bytes"]), _format_bytes(container["disk_bytes"])])
        if not rows:
            print("(no containers)" if session["totals"]["disk_bytes"] is not None else "(containers unavailable)")
        total = session["totals"]
        rows.append(["", "TOTAL", "", "-" if total["cpu_percent"] is None else f"{total['cpu_percent']:.2f}",
                     _format_bytes(total["memory_bytes"]), _format_bytes(total["disk_bytes"])])
        _print_table(rows, ["CONTAINER ID", "NAME", "STATE", "CPU %", "RAM", "DISK (RW)"])


def cmd_stats(args) -> None:
    session_dirs = None
    if args.name is not None or args.session is not None:
        session_dir, _ = resolve_session(args)
        session_dirs = [session_dir]
    snapshot = _collect_stats(session_dirs)
    if args.json:
        print(json.dumps(snapshot, indent=2, allow_nan=False))
    else:
        _print_stats(snapshot)
    for error in snapshot["errors"]:
        identity = "/".join(value for value in (error["session_id"], error["container_id"], error["metric"]) if value)
        print(f"error: {_table_text(identity)}: {error['message']}", file=sys.stderr)
    if not snapshot["complete"]:
        sys.exit(1)


def cmd_list(args) -> None:
    show_all = getattr(args, "all", False)
    as_json = getattr(args, "json", False)
    entries = _list_sessions(show_all)

    if as_json:
        print(json.dumps(entries, indent=2))
        return

    if not entries:
        if not show_all:
            print("No sessions in current project. Run: agentbox init --name <name>")
        else:
            print("No sessions.")
        return

    if show_all:
        headers = ["NAME", "STATUS", "URL", "PROJECT", "SESSION ID"]
        rows = [[e["name"], e["status"], e["url"], e["project"], e["session_id"]] for e in entries]
    else:
        headers = ["NAME", "STATUS", "URL", "SESSION ID"]
        rows = [[e["name"], e["status"], e["url"], e["session_id"]] for e in entries]

    _print_table(rows, headers)


def cmd_containers(args) -> None:
    session_dir, _ = resolve_session(args)
    as_json = getattr(args, "json", False)
    entries = _list_session_containers(session_dir)

    if as_json:
        print(json.dumps(entries, indent=2))
        return

    rows = [[e["id"], e["pid"], e["name"], e["service"] or "-", e["state"]] for e in entries]
    _print_table(rows, ["ID", "PID", "NAME", "SERVICE", "STATE"])


def cmd_status(args) -> None:
    result = subprocess.run(
        ["podman", "ps", "--filter", "label=com.docker.compose.project", "--format", "table {{.Names}}\t{{.Status}}\t{{.Ports}}"],
        capture_output=True, text=True,
    )
    lines = [ln for ln in result.stdout.splitlines() if "agentbox" in ln.lower()]
    print("\n".join(lines) if lines else "(no running containers)")


def cmd_preset(args) -> None:
    sub = args.subcmd or "list"

    if sub == "list":
        names = set()
        for d in [AGENTBOX_HOME / "custom" / "presets", AGENTBOX_HOME / "presets"]:
            if d.is_dir():
                names.update(p.name for p in d.iterdir() if p.is_dir())
        for n in sorted(names):
            print(n)

    elif sub == "edit":
        filename = f"{args.file}.yaml"
        preset_dir = resolve_preset(args.name)
        target = preset_dir / filename
        if not target.is_file():
            die(f"preset '{args.name}' {filename} not found at {target}")
        subprocess.run([os.environ.get("EDITOR", "vi"), str(target)], check=True)
        print(f"Preset saved ({filename}).")

    elif sub == "copy":
        src_dir = resolve_preset(args.src)
        if not src_dir.is_dir():
            die(f"source preset '{args.src}' not found")
        dst_dir = AGENTBOX_HOME / "custom" / "presets" / args.dst
        dst_dir.mkdir(parents=True, exist_ok=True)
        for filename in ["proxy.yaml", "agent.yaml"]:
            src_file = resolve_preset_file(src_dir, filename)
            if src_file:
                shutil.copy(src_file, dst_dir / filename)
        print(f"Created preset '{args.dst}' from '{args.src}'. Edit: agentbox preset edit <proxy|agent> {args.dst}")


def main() -> None:
    def subparser_with_name(p: argparse.ArgumentParser, *, all_sessions: bool = False) -> argparse.ArgumentParser:
        selectors = p.add_mutually_exclusive_group()
        selectors.add_argument("--name", "-n", metavar="NAME",
                               help="Session name in the current project" if all_sessions else "Session name (auto-detected if only one session exists)")
        selectors.add_argument("--session", "-s", metavar="SESSION_ID", help="Full session ID (from 'agentbox list --all'); works from any directory")
        return p

    parser = argparse.ArgumentParser(prog="agentbox", description="Isolated agent workspace manager.")
    subcommand = parser.add_subparsers(dest="cmd")

    build_subcommand = subcommand.add_parser("build", help="Build proxy + agent images")
    build_subcommand.add_argument("harnesses", nargs="*", metavar="HARNESS", help=f"Harness images to build (default: all). Choices: {', '.join(HARNESS_CONTAINERFILES)}")
    build_subcommand.add_argument("-t", "--tag", default=AGENTBOX_IMAGE_TAG, help="Image tag (AGENTBOX_IMAGE_TAG, default: %(default)s).")

    update_subcommand = subcommand.add_parser("update", help="Rebuild images without cache")
    update_subcommand.add_argument("harnesses", nargs="*", metavar="HARNESS", help=f"Harness images to rebuild (default: all). Choices: {', '.join(HARNESS_CONTAINERFILES)}")
    update_subcommand.add_argument("-t", "--tag", default=AGENTBOX_IMAGE_TAG, help="Image tag (AGENTBOX_IMAGE_TAG, default: %(default)s).")

    list_subcommand = subcommand.add_parser("list", aliases=["ls"], help="List sessions for the current project")
    list_subcommand.add_argument("--all", "-a", action="store_true", help="List sessions across all projects")
    list_subcommand.add_argument("--json", action="store_true", help="Output in JSON format")
    containers_subcommand = subparser_with_name(subcommand.add_parser("containers", help="List containers for a session"))
    containers_subcommand.add_argument("--json", action="store_true", help="Output in JSON format")
    stats_subcommand = subparser_with_name(subcommand.add_parser(
        "stats", help="Snapshot CPU, RAM, and writable-layer disk usage grouped by session",
        description="Show one snapshot for all sessions across all projects, including stopped containers. "
                    "Use --name or --session to select one session."), all_sessions=True)
    stats_subcommand.add_argument("--json", action="store_true", help="Output a structured JSON snapshot")
    subcommand.add_parser("status", help="List running agentbox containers")

    init_subcommand = subcommand.add_parser("init", help="Initialize a new agentbox session (use --start to also launch)")
    init_subcommand.add_argument("dir", nargs="?")
    init_subcommand.add_argument("--name", "-n", metavar="NAME", help="Session name (default: timestamp)")
    init_subcommand.add_argument("--preset", "-p", default=AGENTBOX_PRESET)
    init_subcommand.add_argument("--branch", default="")
    init_subcommand.add_argument("--no-git", action="store_true")
    init_subcommand.add_argument("--persist", action="store_true", help="Keep the agent container and its filesystem across starts")
    init_subcommand.add_argument("--ro-mount", action="append", default=[], dest="ro_mounts", metavar="SRC[:DST]", help="Mount read-only reference directory")
    init_subcommand.add_argument("--rw-mount", action="append", default=[], dest="rw_mounts", metavar="SRC[:DST]", help="Mount writable reference directory")
    init_subcommand.add_argument("--start", action="store_true", help="Also start the session after initializing")

    start_subcommand = subcommand.add_parser("start", help="Launch a agentbox session (optionally override the command)")
    subparser_with_name(start_subcommand).add_argument("exec_cmd", nargs="*", metavar="CMD", help="Command to run instead of AGENT_HARNESS (use -- to separate)")

    subparser_with_name(subcommand.add_parser("stop", help="Stop a agentbox session"))
    logs_subcommand = subparser_with_name(subcommand.add_parser("logs", help="Follow the proxy log (all history by default)"))
    logs_subcommand.add_argument("--tail", "-l", type=int, default=None, metavar="N", help="Show only the last N lines (default: all)")
    subparser_with_name(subcommand.add_parser("web", help="Print the mitmweb traffic-monitor URL"))
    subparser_with_name(subcommand.add_parser("remove", help="Stop and delete a session (containers, volumes, git remote, output repo)"))
    allow_subcommand = subparser_with_name(subcommand.add_parser("allow", help="Add a host to the egress allowlist"))
    allow_subcommand.add_argument("host")
    deny_subcommand = subparser_with_name(subcommand.add_parser("deny", help="Remove a host from the egress allowlist"))
    deny_subcommand.add_argument("host")
    subparser_with_name(subcommand.add_parser("proxy-reload", help="Reload the proxy config without restarting"))
    subparser_with_name(subcommand.add_parser("proxy-restart", help="Restart the proxy container"))
    subcommand.add_parser("remote-cleanup", help="Remove agentbox-* git remotes with no matching session")

    preset_subcommand = subcommand.add_parser("preset", help="Manage presets")
    preset_subparser = preset_subcommand.add_subparsers(dest="subcmd")
    preset_subparser.add_parser("list")
    preset_edit = preset_subparser.add_parser("edit", help="Edit proxy or agent config of a preset")
    preset_edit.add_argument("file", choices=["proxy", "agent"])
    preset_edit.add_argument("name", nargs="?", default=AGENTBOX_PRESET)
    preset_copy = preset_subparser.add_parser("copy")
    preset_copy.add_argument("src")
    preset_copy.add_argument("dst")

    args = parser.parse_args()
    if not args.cmd:
        parser.print_help()
        return

    COMMANDS = {
        "build": cmd_build,
        "update": cmd_update,
        "init": cmd_init,
        "start": cmd_start,
        "stop": cmd_stop,
        "logs": cmd_logs,
        "web": cmd_web,
        "allow": cmd_allow,
        "deny": cmd_deny,
        "proxy-reload": cmd_proxy_reload,
        "proxy-restart": cmd_proxy_restart,
        "status": cmd_status,
        "list": cmd_list,
        "ls": cmd_list,
        "containers": cmd_containers,
        "stats": cmd_stats,
        "remove": cmd_remove,
        "remote-cleanup": cmd_remote_cleanup,
        "preset": cmd_preset,
    }

    try:
        COMMANDS[args.cmd](args)
    except subprocess.CalledProcessError as exc:
        sys.exit(exc.returncode)
    except KeyboardInterrupt:
        sys.exit(130)
    except (OSError, ValueError, RuntimeError, yaml.YAMLError):
        die("Could not read session or container information; verify the session metadata and Podman connection")


if __name__ == "__main__":
    main()
