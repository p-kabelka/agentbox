#!/usr/bin/env python3
"""Snapshot a stopped dc4dfe0 persistent session into a new, isolated session."""

import argparse
import io
import json
import re
import runpy
import shutil
import subprocess
import sys
import tarfile
import tempfile
from pathlib import Path


# Keep this one-off out of the normal CLI and startup path.
CLI = runpy.run_path(str(Path(__file__).resolve().with_name("agentbox")))


def run(*args, **kwargs):
    return subprocess.run(args, check=True, **kwargs)


def git(path, *args, **kwargs):
    return run("git", "-C", str(path), "-c", "core.hooksPath=/dev/null", *args, **kwargs)


def git_value(path, *args):
    return git(path, *args, text=True, stdout=subprocess.PIPE).stdout.strip()


def missing_container_path(error):
    return "could not be found on container" in error and error.endswith("no such file or directory")


def add_startup_tools(snapshot, tools, image):
    agent_dir = CLI["AGENTBOX_HOME"] / "agent"
    run("podman", "build", "--pull=never", "--network=none", "--layers=false",
        "--build-arg", f"TOOLS_IMAGE={tools}", "--build-arg", f"SNAPSHOT_IMAGE={snapshot}",
        "--file", str(agent_dir / "migrate-dc4dfe0" / "Containerfile"), "--tag", image, str(agent_dir))


def update_workspace_remote(container, scratch):
    path = "/workspace/.git/config"
    result = subprocess.run(("podman", "cp", f"{container}:{path}", "-"), capture_output=True)
    if result.returncode:
        error = result.stderr.decode(errors="replace").strip()
        if missing_container_path(error):
            return  # Nothing to rewrite if the original never cloned.
        CLI["die"](error or f"could not read {path}")
    with tarfile.open(fileobj=io.BytesIO(result.stdout)) as archive:
        member = archive.getmember("config")
        if not member.isreg():
            CLI["die"](f"expected a regular file at {path}; inspect the old workspace before migrating")
        config = scratch / "config"
        config.write_bytes(archive.extractfile(member).read())
        config.chmod(member.mode & 0o777)
    args = ("git", "config", "--file", str(config), "--no-includes")
    # Only rewrite the exact legacy URLs; preserve any other remotes and
    # existing branch tracking. Never run Git against the sandbox worktree.
    changed = False
    for key, old in (("remote.origin.url", "/output/repo.git"),
                     ("remote.origin.pushurl", "/output/repo.git"),
                     ("remote.source.url", "/source/project.bundle")):
        value = subprocess.run((*args, "--get-all", key), capture_output=True, text=True)
        if value.returncode not in (0, 1):
            value.check_returncode()
        if old in value.stdout.splitlines():
            run(*args, "--fixed-value", "--replace-all", key, "git://git/workspace.git", old)
            changed = True
    if changed:
        run("podman", "cp", str(config), f"{container}:/workspace/.git/")


def seed_workspace(source, target, git_dir, scratch):
    repo = scratch / "workspace.git"
    bundle = source / "source.bundle"
    output = source / "output.git"
    git(scratch, "clone", "--bare", "--quiet", "--", str(bundle.resolve()), str(repo))
    head = subprocess.run(("git", "-C", str(repo), "symbolic-ref", "-q", "HEAD"),
                          capture_output=True, text=True)
    if head.returncode == 1:
        commit = git_value(repo, "rev-parse", "HEAD")
        branch = "snapshot-" + commit[:12]
        git(repo, "update-ref", f"refs/heads/{branch}", commit)
    else:
        head.check_returncode()
        branch = head.stdout.strip().removeprefix("refs/heads/")
    # The original bundle provides the initial source; published branches and
    # tags take precedence when the old output has refs with the same names.
    git(repo, "fetch", "--quiet", "--no-tags", "--", str(output.resolve()),
        "+refs/heads/*:refs/heads/*", "+refs/tags/*:refs/tags/*")
    compose = CLI["compose"]
    CLI["_start_git"](target)
    compose(target, "exec", "-T", "git", "python3", "/app/server.py", "init", "workspace", branch,
            git_value(repo, "rev-parse", "--show-object-format"), check=True)
    CLI["_save_git_repositories"](target, {"workspace": git_dir})
    url = CLI["_git_url"](target, "workspace")
    # Use this checkout's helper for the migration itself, even for tagged images.
    git(repo, "push", "--quiet", f"agentbox::{url.partition('::')[2]}",
        "refs/heads/*:refs/heads/*", "refs/tags/*:refs/tags/*", env=CLI["_git_environment"](target))
    compose(target, "exec", "-T", "git", "python3", "/app/server.py", "publish", "workspace", branch, check=True)
    return url


def migrate(args):
    source, project = CLI["resolve_session"](args)
    if not re.fullmatch(r"[a-z0-9][a-z0-9._-]*", args.new_name):
        CLI["die"]("invalid --new-name; use lowercase letters, digits, dots, underscores, or hyphens")
    project = project.resolve()
    target = source.parent / CLI["_session_id"](args.new_name, project)
    if target.exists():
        CLI["die"](f"destination session '{args.new_name}' already exists; choose an unused name")

    with CLI["_secret_sync_lock"](source), CLI["_agent_lifetime"](source):
        cfg = CLI["load_yaml"](source / "compose.yaml")
        meta, services = cfg["x-metadata"], cfg["services"]
        if not CLI["_persistent"](meta) or set(services) != {"agent", "proxy"} or "no-git" in meta:
            CLI["die"]("expected a pre-sidecar persistent session created by dc4dfe0")
        expected = CLI["AGENTBOX_STATE"] / "sessions" / CLI["_session_id"](meta["name"], project)
        if source.resolve() != expected.resolve():
            CLI["die"]("original session path does not match its saved project and name")
        agent, proxy = services["agent"], services["proxy"]
        bundle, output = source / "source.bundle", source / "output.git"
        mounts = agent.get("volumes", [])
        git_backed = ("./source.bundle:/source/project.bundle:ro,Z" in mounts
                      and "./output.git:/output/repo.git:Z" in mounts)
        if git_backed and (not bundle.is_file() or not output.is_dir()):
            CLI["die"]("the original source.bundle or output.git is missing")
        if not git_backed and (not args.no_git or f"{project}:/workspace:Z" not in mounts
                               or bundle.exists() or output.exists()):
            CLI["die"]("expected a legacy bundle/output workspace, or its original project bind with explicit --no-git")
        if git_backed and args.no_git:
            CLI["die"]("do not pass --no-git for a bundle/output workspace")
        if not project.is_dir():
            CLI["die"](f"project directory does not exist: {project}")

        containers = CLI["_list_session_containers"](CLI["_project_name"](source, meta))
        if any(c["state"] not in {"configured", "created", "exited", "stopped"} for c in containers):
            CLI["die"]("stop all original session containers before migrating")
        context_mounts = CLI["_read_context_mounts"](source)
        old_agent_name = CLI["_service_container_name"](source, "agent")
        old_agent = next((c["id"] for c in containers if c["name"] == old_agent_name), None)
        snapshot_image = f"localhost/{CLI['_service_container_name'](target, 'agent')}:migrated-dc4dfe0"
        tools_image = f"localhost/agentbox-agent-base:{CLI['AGENTBOX_IMAGE_TAG']}"
        if old_agent:
            if args.agent_image:
                CLI["die"]("do not pass --agent-image: the replacement uses the original agent filesystem")
            inspect = json.loads(run("podman", "inspect", old_agent, capture_output=True).stdout)[0]
            original = inspect["Config"]
            if (original["Entrypoint"] not in ("/start.sh", ["/start.sh"])
                    or original.get("User", "") not in ("", "0", "0:0", "root")
                    or any(e.startswith("HOME=") and e != "HOME=/root" for e in original.get("Env", []))):
                CLI["die"]("only the standard /start.sh entrypoint and root home (/root) are supported")
            known_mounts = {"/proxy-ca", "/agentbox-dotfiles", *(f"/context/{dst}" for _, dst, _ in context_mounts)}
            if git_backed:
                known_mounts.update(("/source/project.bundle", "/output/repo.git",
                                     "/output/repo.git/hooks", "/output/repo.git/config"))
            else:
                known_mounts.add("/workspace")
            for mount in inspect["Mounts"]:
                if mount["Destination"] not in known_mounts:
                    CLI["die"](f"unsupported mount at {mount['Destination']} in the old agent; "
                               "mounted data is not snapshotted")
            if original.get("OnBuild"):
                CLI["die"]("the old image has ONBUILD instructions; refusing to run them during migration")
            if subprocess.run(("podman", "image", "exists", snapshot_image)).returncode == 0:
                CLI["die"](f"image {snapshot_image} already exists; choose another destination name")
            image = snapshot_image
        else:
            old_image, _, _ = agent["image"].rpartition(":")
            if not args.agent_image and not re.fullmatch(r"localhost/agentbox-agent-[a-z0-9-]+", old_image):
                CLI["die"]("specify a current HEAD-compatible image with --agent-image")
            image = args.agent_image or f"{old_image}:{CLI['AGENTBOX_IMAGE_TAG']}"
        # Retain session settings, not old container settings that control the
        # entrypoint, runtime or network. HEAD's Compose base owns those.
        agent_env = dict(agent.get("environment", {}))
        for key in ("NO_PROXY", "no_proxy"):
            agent_env[key] = ",".join(dict.fromkeys(
                ["proxy", "git", "localhost", "127.0.0.1", *filter(None, agent_env.get(key, "").split(","))]))
        annotations = dict(agent.get("annotations", {}))
        if args.use_passt:
            annotations["krun.use_passt"] = "1"
        agent_cfg = {"agent_image": image, "environment": agent_env, "annotations": annotations}
        remote = CLI["_git_remote_name"](target)
        if git_backed:
            git_dir = str(Path(git_value(project, "rev-parse", "--path-format=absolute", "--git-common-dir")).resolve())
            if remote in git_value(project, "remote").splitlines():
                CLI["die"](f"host Git remote '{remote}' already exists; choose another name")

        target.mkdir()
        snapshot = None
        with CLI["_secret_sync_lock"](target, initializing=True), tempfile.TemporaryDirectory() as tmp:
            try:
                for name in ("proxy-config", "dotfiles"):
                    if (source / name).is_dir():
                        shutil.copytree(source / name, target / name)
                CLI["generate_compose"](target, project, args.new_name, CLI["free_port"](),
                                        {"environment": proxy.get("environment", {})}, agent_cfg,
                                        context_mounts, persist=True, no_git=args.no_git)
                compose_path = target / "compose.yaml"
                replacement = CLI["load_yaml"](compose_path)
                # Preserve OAuth and custom CA mounts without restoring any of
                # the agent's obsolete source/output binds.
                replacement["services"]["proxy"]["volumes"].extend(
                    mount for mount in proxy.get("volumes", []) if mount not in (
                        "proxy-ca:/root/.mitmproxy:z", "./proxy-config:/config:ro,Z",
                    ))
                if old_agent and original.get("Cmd"):
                    replacement["services"]["agent"]["command"] = original["Cmd"]
                elif not old_agent and "command" in agent:
                    replacement["services"]["agent"]["command"] = agent["command"]
                CLI["save_yaml"](compose_path, replacement)
                images = {s["image"] for s in replacement["services"].values()}
                if old_agent:
                    images.remove(snapshot_image)
                    images.add(tools_image)
                for image in sorted(images):
                    if subprocess.run(("podman", "image", "exists", image)).returncode:
                        CLI["die"](f"image {image} is not available locally; build the current images first")

                with CLI["_git_metadata_lock"](target):
                    if old_agent:
                        # The commit contains image and writable layers only,
                        # never the old host mounts. The build only adds files.
                        snapshot = run("podman", "commit", "--quiet", "--include-volumes=false", old_agent,
                                       stdout=subprocess.PIPE, text=True).stdout.strip()
                        add_startup_tools(snapshot, tools_image, snapshot_image)
                        # Only create the agent: start will synchronize credentials
                        # and install the guard as usual before it can boot.
                        CLI["compose"](target, "up", "-d", "--no-recreate", "network", check=True)
                        new_agent = CLI["_service_container_name"](target, "agent")
                        CLI["_create_persistent_agent"](target, CLI["_project_name"](target, replacement["x-metadata"]),
                                                       new_agent, None)
                        if git_backed:
                            update_workspace_remote(new_agent, Path(tmp))
                    if git_backed:
                        url = seed_workspace(source, target, git_dir, Path(tmp))
                    CLI["_stop_persistent"](target)
                    if git_backed:
                        git(project, "remote", "add", remote, url)
            except BaseException:
                # The original is never a teardown target.
                if (target / "compose.yaml").is_file():
                    result = CLI["compose"](target, "down", "-v")
                    if result.returncode:
                        print(f"Could not clean up the replacement; inspect session {target.name}", file=sys.stderr)
                        raise
                if snapshot:
                    subprocess.run(("podman", "rmi", "--ignore", snapshot_image))
                    subprocess.run(("podman", "rmi", "--ignore", snapshot))
                shutil.rmtree(target)
                raise

    print(f"==> Original session unchanged. Start the replacement with:")
    print(f"agentbox start --session {target.name}")
    if old_agent:
        print(f"==> The private image {snapshot_image} contains your agent data. Do not publish it.")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument("--session", "-s", help="Full original session ID (from agentbox list --all)")
    source.add_argument("--name", "-n", help="Original session name in the current project")
    parser.add_argument("--new-name", required=True, help="Unused name for the replacement session")
    parser.add_argument("--agent-image", help="Current compatible image for an unstarted session only")
    parser.add_argument("--no-git", action="store_true", help="Explicitly retain a legacy writable project bind")
    parser.add_argument("--use-passt", action="store_true", help="Enable passt on the replacement (requires compatible krun)")
    try:
        migrate(parser.parse_args())
    except (OSError, ValueError, subprocess.CalledProcessError, tarfile.TarError) as exc:
        CLI["die"](str(exc))


if __name__ == "__main__":
    main()
